{
	"name": "captain-jacks-ban-pool",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"scripts": {
		"check:node": "node scripts/check-node-version.cjs",
		"dev": "npm run check:node && vite dev",
		"build": "npm run check:node && vite build",
		"preview": "npm run check:node && vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run check:node && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "npm run check:node && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"seed:data": "npm run check:node && node --env-file=.env.local scripts/reset-ban-data.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.47.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@types/node": "^24.10.1",
		"svelte": "^5.41.0",
		"svelte-check": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^7.1.10"
	},
	"dependencies": {
		"cookie": "^1.0.2",
		"date-fns": "^4.1.0",
		"mongodb": "^7.0.0",
		"zod": "^4.1.12"
	}
}
